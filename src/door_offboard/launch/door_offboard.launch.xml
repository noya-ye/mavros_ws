<launch>
  <arg name="config" default="$(find-pkg-share door_offboard)/config/door_offboard.yaml"/>
  <node pkg="door_offboard" exec="perception_node" name="door_perception" output="screen">
    <param from="$(var config)"/>
  </node>
  <node pkg="door_offboard" exec="flight_node" name="door_flight" output="screen">
    <param from="$(var config)"/>
  </node>
</launch>
